{
  "meta": {
    "name": "heritage-trail",
    "version": "0.6.0-ui-tokens",
    "status": "approved-palette",
    "note": "Palette H3, typography T1, radius R1 approved. Density pending."
  },
  "color": {
    "bg": "#eef0ea",
    "surface": "#e2e6dd",
    "surfaceRaised": "#d5dacf",
    "ink": "#141a17",
    "inkMuted": "#5d6a62",
    "border": "#b9c2b6",
    "accent": "#b5311f",
    "onAccent": "#ffffff",
    "accentAlt": "#2f6b5e",
    "success": "#3f6e3a",
    "warning": "#b07a26",
    "danger": "#7e1a10"
  },
  "fonts": {
    "display": "'Palatino Linotype','Book Antiqua',Georgia,serif",
    "body": "'Segoe UI','Segoe UI Variable Text',system-ui,sans-serif",
    "mono": "Consolas,'Cascadia Mono',monospace"
  },
  "fluid": {
    "pattern": "clamp(MIN, calc(MIN + (PREF-MIN)*((100vw - 360px)/(1440-360))), MAX)",
    "fs": {
      "display": "clamp(2.75rem, 1.6rem + 5.2vw, 5.5rem)",
      "h1": "clamp(2rem, 1.35rem + 2.9vw, 3.75rem)",
      "h2": "clamp(1.5rem, 1.15rem + 1.6vw, 2.5rem)",
      "h3": "clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem)",
      "body": "clamp(1rem, 0.96rem + 0.2vw, 1.125rem)",
      "small": "clamp(0.8125rem, 0.79rem + 0.12vw, 0.875rem)",
      "micro": "clamp(0.6875rem, 0.67rem + 0.1vw, 0.75rem)"
    },
    "space": {
      "2xs": "clamp(0.25rem, 0.23rem + 0.1vw, 0.375rem)",
      "xs": "clamp(0.5rem, 0.45rem + 0.2vw, 0.75rem)",
      "sm": "clamp(0.75rem, 0.68rem + 0.3vw, 1rem)",
      "md": "clamp(1rem, 0.9rem + 0.5vw, 1.5rem)",
      "lg": "clamp(1.5rem, 1.3rem + 1vw, 2.5rem)",
      "xl": "clamp(2rem, 1.6rem + 2vw, 4rem)",
      "2xl": "clamp(3rem, 2.2rem + 4vw, 6rem)"
    }
  },
  "radius": {
    "sm": "2px",
    "md": "4px",
    "lg": "6px",
    "pill": "999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgb(31 18 9 / .18)",
    "md": "0 10px 30px -12px rgb(31 18 9 / .28)",
    "lg": "0 24px 60px -20px rgb(31 18 9 / .35)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "slower": "480ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)",
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "easeIn": "cubic-bezier(0.4, 0, 1, 1)"
  },
  "layout": {
    "gutter": "clamp(1.25rem, 0.6rem + 3.4vw, 4.5rem)",
    "max": "calc(100% - 2 * var(--gutter))",
    "maxWidth": "1280px",
    "gridMin": "clamp(15rem, 28vw, 22rem)"
  },
  "ui": {
    "chipPadding": "3px 8px",
    "inputPadding": "6px 10px",
    "captionPadding": "4px 8px",
    "tableCellPadding": "10px",
    "panelPadding": "clamp(1rem, 0.9rem + 0.5vw, 1.5rem)",
    "topbarPadding": "10px 24px",
    "sidebarWidth": "220px",
    "sideItemPadding": "8px 10px",
    "overlayStrong": "88%",
    "overlaySoft": "8%"
  }
}
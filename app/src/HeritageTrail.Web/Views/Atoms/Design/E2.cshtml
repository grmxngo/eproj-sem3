@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>E2 — Bento complete</title>
<style>
    * { box-sizing: border-box; }
    body { margin: 0; background: #141414; color: #f2ead9; font-family: 'Segoe UI', system-ui, sans-serif; }
    a { color: inherit; text-decoration: none; }
    header { display: flex; justify-content: space-between; align-items: center; padding: 16px 32px; border-bottom: 1px solid rgb(242 234 217 / .16); }
    .brand { font-family: Georgia, serif; font-size: 22px; }
    nav { display: flex; gap: 20px; font-size: 12px; color: rgb(242 234 217 / .7); }
    .btn { display: inline-block; background: #d6452e; color: #fff; padding: 11px 18px; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; }
    .bento { display: grid; grid-template-columns: repeat(12, 1fr); gap: 12px; padding: 12px 32px 32px; }
    .tile { position: relative; overflow: hidden; background: #1d1d1d; }
    .hero { grid-column: span 7; min-height: 520px; }
    .hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .hero .overlay { position: absolute; inset: 0; padding: 32px; display: flex; flex-direction: column; justify-content: flex-end; background: linear-gradient(180deg, rgb(20 20 20 / .1) 35%, rgb(20 20 20 / .92) 100%); }
    .eyebrow { font-size: 10px; letter-spacing: .22em; text-transform: uppercase; color: #d6452e; margin: 0 0 12px; }
    .hero h1 { font-family: Georgia, serif; font-size: 46px; line-height: 1.02; margin: 0 0 14px; font-weight: 400; max-width: 16ch; }
    .hero p { font-size: 15px; color: rgb(242 234 217 / .78); margin: 0 0 20px; max-width: 44ch; }
    .events { grid-column: span 5; min-height: 520px; background: #d6452e; color: #141414; padding: 24px; display: flex; flex-direction: column; }
    .events h2 { font-family: Georgia, serif; font-weight: 400; font-size: 28px; margin: 0 0 10px; }
    .ev { display: grid; grid-template-columns: 64px 1fr; gap: 12px; padding: 13px 0; border-top: 1px solid rgb(20 20 20 / .25); align-items: baseline; }
    .ev b { font-size: 11px; letter-spacing: .06em; }
    .ev .t { font-size: 17px; }
    .ev .m { font-size: 11px; opacity: .72; margin-top: 2px; }
    .events .all { margin-top: auto; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; border-bottom: 1px solid; align-self: flex-start; padding-bottom: 2px; }
    .stats { grid-column: span 4; min-height: 210px; background: #f2ead9; color: #141414; padding: 22px; display: flex; flex-direction: column; justify-content: space-between; }
    .stats .row { display: flex; gap: 30px; }
    .stats b { display: block; font-family: Georgia, serif; font-size: 44px; font-weight: 400; line-height: 1; }
    .stats span { font-size: 10px; letter-spacing: .12em; text-transform: uppercase; }
    .stats p { margin: 0; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: rgb(20 20 20 / .6); }
    .quote { grid-column: span 4; min-height: 210px; background: #232323; padding: 22px; display: flex; align-items: flex-end; }
    .quote p { margin: 0; font-family: Georgia, serif; font-size: 24px; line-height: 1.22; }
    .cta { grid-column: span 4; min-height: 210px; background: #2c2c2c; padding: 22px; display: flex; flex-direction: column; justify-content: space-between; }
    .cta h2 { font-family: Georgia, serif; font-weight: 400; font-size: 26px; margin: 0; }
    .img { grid-column: span 4; height: 240px; }
    .img img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .img span { position: absolute; left: 12px; bottom: 10px; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; background: rgb(20 20 20 / .65); padding: 3px 7px; }
    footer { display: flex; justify-content: space-between; padding: 20px 32px; border-top: 1px solid rgb(242 234 217 / .16); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: rgb(242 234 217 / .5); }
</style>
</head>
<body>
<header>
    <a class="brand" href="#">HeritageTrail</a>
    <nav><a href="#">Home</a><a href="#">Heritage Sites</a><a href="#">Explore</a><a href="#">About us</a><a href="#">Events</a><a href="#">Gallery</a></nav>
    <a class="btn" href="#">Register</a>
</header>
<main class="bento">
    <div class="tile hero">
        <img src="/images/preview/hero.jpg" alt="Preview photograph" />
        <div class="overlay">
            <p class="eyebrow">Sites · Programmes · Membership</p>
            <h1>Heritage sites, walks and exhibitions</h1>
            <p>Eight sites, four continents, one organisation. Facts, dates and access — plus the programmes we run on site.</p>
            <a class="btn" href="#">See what's on</a>
        </div>
    </div>
    <div class="tile events">
        <h2>What's on</h2>
        <div class="ev"><b>Sat 07:00</b><div><div class="t">Temple Walk — Angkor</div><div class="m">Angkor Wat west causeway</div></div></div>
        <div class="ev"><b>Sat 20:30</b><div><div class="t">Petra by Night</div><div class="m">The Siq, Petra</div></div></div>
        <div class="ev"><b>Sun 15:00</b><div><div class="t">Mughal Marble Talk</div><div class="m">Agra heritage centre</div></div></div>
        <a class="all" href="#">All events →</a>
    </div>
    <div class="tile stats">
        <div class="row">
            <div><b>8</b><span>sites</span></div>
            <div><b>4</b><span>continents</span></div>
            <div><b>64</b><span>walks since 2019</span></div>
        </div>
        <p>Programmes run with site partners</p>
    </div>
    <div class="tile quote"><p>“What survives is a fact. Seeing it is a programme.”</p></div>
    <div class="tile cta">
        <h2>Join a programme</h2>
        <a class="btn" href="#">Register</a>
    </div>
    <div class="tile img"><img src="/images/preview/card1.jpg" alt="Angkor preview" /><span>Angkor Wat · Temples</span></div>
    <div class="tile img"><img src="/images/preview/card2.jpg" alt="Petra preview" /><span>Petra · Monuments</span></div>
    <div class="tile img"><img src="/images/preview/card3.jpg" alt="Machu Picchu preview" /><span>Machu Picchu · Monuments</span></div>
</main>
<footer><span>HeritageTrail · worldwide</span><span>Preview — placeholder photos</span></footer>
</body>
</html>

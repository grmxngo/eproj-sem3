@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>E4 — Trail complete</title>
<style>
    * { box-sizing: border-box; }
    body { margin: 0; background: #f7f4ec; color: #111111; font-family: 'Segoe UI', system-ui, sans-serif; }
    a { color: inherit; text-decoration: none; }
    header { display: flex; justify-content: space-between; align-items: center; padding: 18px 44px; border-bottom: 1px solid rgb(17 17 17 / .18); }
    .brand { font-family: Georgia, serif; font-size: 22px; }
    nav { display: flex; gap: 20px; font-size: 12px; color: rgb(17 17 17 / .7); }
    .btn { display: inline-block; background: #b5311f; color: #fff; padding: 12px 20px; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; }
    .hero { display: grid; grid-template-columns: 1.2fr .8fr; gap: 44px; padding: 56px 44px 20px; align-items: end; }
    .kicker { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: #b5311f; margin: 0 0 14px; }
    h1 { font-family: Georgia, serif; font-size: clamp(48px, 6vw, 84px); line-height: .98; margin: 0; font-weight: 400; }
    .lede { font-size: 16px; line-height: 1.5; color: #555; max-width: 42ch; margin: 18px 0 24px; }
    .facts { border: 1px solid #111; padding: 20px 22px; }
    .facts div { display: flex; justify-content: space-between; padding: 9px 0; border-bottom: 1px solid rgb(17 17 17 / .18); font-size: 13px; }
    .facts div:last-of-type { border-bottom: 0; }
    .facts b { font-family: Georgia, serif; font-size: 20px; font-weight: 400; }
    .facts .note { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: #777; padding-top: 10px; }
    .trail { position: relative; padding: 40px 44px 8px; }
    .trail::before { content: ""; position: absolute; left: 44px; right: 44px; top: 67px; border-top: 2px dashed #111; opacity: .5; }
    .nodes { display: flex; gap: 26px; justify-content: space-between; }
    .node { flex: 1; display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
    .dot { width: 15px; height: 15px; border-radius: 50%; background: #f7f4ec; border: 2px solid #111; position: relative; z-index: 1; }
    .node b { font-family: Georgia, serif; font-size: 20px; font-weight: 400; }
    .node span { font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #777; }
    .node img { width: 100%; height: 130px; object-fit: cover; display: block; filter: grayscale(.2); }
    .events { display: flex; gap: 16px; flex-wrap: wrap; padding: 10px 44px 28px; }
    .ev { border: 1px solid #111; border-radius: 999px; padding: 9px 16px; font-size: 12px; display: flex; gap: 10px; align-items: center; }
    .ev b { color: #b5311f; font-size: 11px; letter-spacing: .1em; }
    .about { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; padding: 34px 44px; border-top: 1px solid rgb(17 17 17 / .18); align-items: center; }
    .about h2 { font-family: Georgia, serif; font-size: 34px; font-weight: 400; margin: 0 0 12px; }
    .about p { font-size: 15px; line-height: 1.55; color: #555; margin: 0 0 18px; max-width: 46ch; }
    .about img { width: 100%; height: 260px; object-fit: cover; display: block; filter: grayscale(.2); }
    footer { display: flex; justify-content: space-between; padding: 20px 44px; border-top: 1px solid rgb(17 17 17 / .18); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: #777; }
</style>
</head>
<body>
<header>
    <a class="brand" href="#">HeritageTrail</a>
    <nav><a href="#">Home</a><a href="#">Heritage Sites</a><a href="#">Explore</a><a href="#">About us</a><a href="#">Events</a><a href="#">Gallery</a></nav>
    <a class="btn" href="#">Register</a>
</header>

<section class="hero">
    <div>
        <p class="kicker">A trail across four continents</p>
        <h1>Sites, joined by a programme.</h1>
        <p class="lede">Pick a site, join the walk, keep the facts. Eight heritage sites, five categories, one organisation.</p>
        <a class="btn" href="#">See what's on</a>
    </div>
    <div class="facts">
        <div><span>Heritage sites</span><b>8</b></div>
        <div><span>Categories</span><b>5</b></div>
        <div><span>Upcoming programmes</span><b>4</b></div>
        <div><span>Continents</span><b>4</b></div>
        <div class="note">Programmes run with site partners</div>
    </div>
</section>

<section class="trail">
    <div class="nodes">
        <a class="node" href="#"><span class="dot"></span><img src="/images/preview/card1.jpg" alt="Angkor preview" /><b>Angkor Wat</b><span>Cambodia · Temples</span></a>
        <a class="node" href="#"><span class="dot"></span><img src="/images/preview/card2.jpg" alt="Petra preview" /><b>Petra</b><span>Jordan · Monuments</span></a>
        <a class="node" href="#"><span class="dot"></span><img src="/images/preview/card3.jpg" alt="Machu Picchu preview" /><b>Machu Picchu</b><span>Peru · Monuments</span></a>
        <a class="node" href="#"><span class="dot"></span><img src="/images/preview/hero.jpg" alt="Preview" /><b>Taj Mahal</b><span>India · Monuments</span></a>
    </div>
</section>

<section class="events">
    <span class="ev"><b>Sat 07:00</b> Temple Walk — Angkor</span>
    <span class="ev"><b>20:30</b> Petra by Night</span>
    <span class="ev"><b>Sun 15:00</b> Mughal Marble Talk</span>
    <span class="ev"><b>→</b> All programmes</span>
</section>

<section class="about">
    <div>
        <h2>What we do</h2>
        <p>We run walks, talks and exhibitions at heritage sites, and publish what survives at each one — with dates, access and the facts behind the photo.</p>
        <a class="btn" href="#">About us</a>
    </div>
    <img src="/images/preview/hero.jpg" alt="Preview photograph" />
</section>

<footer><span>HeritageTrail · worldwide</span><span>Preview — placeholder photos</span></footer>
</body>
</html>

@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>D1 — Cinematic ink</title>
<style>
    * { box-sizing: border-box; }
    body { margin: 0; background: #14110c; color: #f2ece1; font-family: 'Segoe UI', system-ui, sans-serif; }
    a { color: inherit; text-decoration: none; }
    header { display: flex; justify-content: space-between; align-items: center; padding: 20px 48px; border-bottom: 1px solid rgb(242 236 225 / .14); }
    .brand { font-family: Georgia, serif; font-size: 22px; }
    nav { display: flex; gap: 24px; font-size: 13px; color: rgb(242 236 225 / .7); }
    nav a:hover { color: #fff; }
    .register { color: #c2492a; font-size: 12px; letter-spacing: .14em; border-bottom: 1px solid #c2492a; padding-bottom: 2px; }
    .hero { position: relative; height: 560px; overflow: hidden; }
    .hero img { width: 100%; height: 100%; object-fit: cover; display: block; filter: grayscale(.25) contrast(1.05); }
    .hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(20 17 12 / .15) 0%, rgb(20 17 12 / .85) 80%); }
    .hero-content { position: absolute; left: 48px; right: 48px; bottom: 48px; z-index: 2; max-width: 900px; }
    .eyebrow { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: #c2492a; margin: 0 0 12px; }
    h1 { font-family: Georgia, serif; font-size: clamp(44px, 6vw, 88px); line-height: .98; margin: 0 0 16px; font-weight: 400; }
    .lede { font-size: 16px; line-height: 1.5; color: rgb(242 236 225 / .78); max-width: 46ch; margin: 0 0 24px; }
    .actions { display: flex; gap: 14px; align-items: center; }
    .btn { background: #c2492a; color: #fff; padding: 13px 22px; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; }
    .ghost { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; border-bottom: 1px solid rgb(242 236 225 / .4); padding-bottom: 3px; }
    .section { padding: 56px 48px; max-width: 1280px; margin: 0 auto; }
    .section h2 { font-family: Georgia, serif; font-size: 32px; font-weight: 400; margin: 0 0 24px; }
    .event { display: grid; grid-template-columns: 120px 1fr auto; gap: 24px; align-items: center; padding: 18px 0; border-top: 1px solid rgb(242 236 225 / .14); }
    .date { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: #d8a13f; }
    .title { font-family: Georgia, serif; font-size: 24px; }
    .cta { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: #c2492a; }
    .sites { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .site img { width: 100%; height: 200px; object-fit: cover; display: block; filter: grayscale(.2); }
    .site b { display: block; font-family: Georgia, serif; font-weight: 400; font-size: 20px; margin-top: 10px; }
    .site span { font-size: 12px; color: rgb(242 236 225 / .6); }
    footer { padding: 24px 48px; border-top: 1px solid rgb(242 236 225 / .14); font-size: 12px; color: rgb(242 236 225 / .55); display: flex; justify-content: space-between; }
</style>
</head>
<body>
<header>
    <a class="brand" href="#">HeritageTrail</a>
    <nav><a href="#">Heritage Sites</a><a href="#">Events</a><a href="#">Gallery</a><a href="#">About us</a></nav>
    <a class="register" href="#">REGISTER</a>
</header>
<section class="hero">
    <img src="/images/preview/hero.jpg" alt="Heritage landscape — preview placeholder" />
    <div class="hero-content">
        <p class="eyebrow">HeritageTrail · worldwide</p>
        <h1>What survives</h1>
        <p class="lede">Walks, talks and exhibitions at heritage sites across four continents — with the facts behind each site.</p>
        <div class="actions"><a class="btn" href="#">See what's on</a><a class="ghost" href="#">Explore sites</a></div>
    </div>
</section>
<section class="section">
    <h2>What's on</h2>
    <div class="event"><span class="date">Sat 07:00</span><span class="title">Temple Walk — Angkor</span><span class="cta">Interested →</span></div>
    <div class="event"><span class="date">Sat 20:30</span><span class="title">Petra by Night</span><span class="cta">Interested →</span></div>
</section>
<section class="section" style="padding-top:0">
    <h2>Sites</h2>
    <div class="sites">
        <a class="site" href="#"><img src="/images/preview/card1.jpg" alt="Angkor — preview" /><b>Angkor Wat</b><span>Temples · Cambodia</span></a>
        <a class="site" href="#"><img src="/images/preview/card2.jpg" alt="Petra — preview" /><b>Petra</b><span>Monuments · Jordan</span></a>
        <a class="site" href="#"><img src="/images/preview/card3.jpg" alt="Machu Picchu — preview" /><b>Machu Picchu</b><span>Monuments · Peru</span></a>
    </div>
</section>
<footer><span>HeritageTrail</span><span>Preview — placeholder photos (replace with site photography)</span></footer>
</body>
</html>

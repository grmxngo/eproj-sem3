@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>E1 — Split cover</title>
<style>
    * { box-sizing: border-box; }
    body { margin: 0; background: #f4eee1; color: #12332b; font-family: 'Segoe UI', system-ui, sans-serif; }
    a { color: inherit; text-decoration: none; }
    header { display: flex; justify-content: space-between; align-items: center; padding: 18px 40px; border-bottom: 1px solid rgb(18 51 43 / .16); }
    .brand { font-family: Georgia, serif; font-size: 22px; }
    nav { display: flex; gap: 20px; font-size: 12px; letter-spacing: .04em; color: rgb(18 51 43 / .75); }
    .btn { background: #c35427; color: #fff4e8; padding: 11px 18px; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; }
    .split { display: grid; grid-template-columns: 1.05fr 1fr; min-height: 620px; }
    .left { background: #12332b; color: #f4eee1; padding: 56px 48px 40px; display: flex; flex-direction: column; }
    .eyebrow { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: #c35427; margin: 0 0 16px; }
    h1 { font-family: Georgia, serif; font-size: clamp(64px, 8vw, 116px); line-height: .9; margin: 0 0 20px; font-weight: 400; }
    .sub { font-size: 16px; line-height: 1.5; color: rgb(244 238 225 / .75); max-width: 36ch; margin: 0 0 28px; }
    .actions { display: flex; gap: 18px; align-items: center; margin-bottom: 44px; }
    .ghost { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; border-bottom: 1px solid rgb(244 238 225 / .45); padding-bottom: 3px; }
    .index { list-style: none; margin: auto 0 0; padding: 0; border-top: 1px solid rgb(244 238 225 / .22); }
    .index li { display: grid; grid-template-columns: 40px 1fr auto; gap: 14px; padding: 12px 0; border-bottom: 1px solid rgb(244 238 225 / .12); align-items: baseline; }
    .index b { font-weight: 400; font-size: 11px; letter-spacing: .1em; color: #c35427; }
    .index .n { font-family: Georgia, serif; font-size: 19px; }
    .index span { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: rgb(244 238 225 / .55); }
    .right { position: relative; }
    .right img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .right figcaption { position: absolute; left: 16px; bottom: 14px; font-size: 10px; letter-spacing: .08em; color: rgb(244 238 225 / .8); background: rgb(18 51 43 / .55); padding: 4px 8px; }
    .strip { display: flex; gap: 28px; align-items: center; padding: 16px 40px; background: #c35427; color: #fff4e8; font-size: 12px; flex-wrap: wrap; }
    .strip b { letter-spacing: .16em; text-transform: uppercase; font-weight: 600; font-size: 11px; }
    .strip a { margin-left: auto; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; border-bottom: 1px solid; padding-bottom: 2px; }
</style>
</head>
<body>
<header>
    <a class="brand" href="#">HeritageTrail</a>
    <nav><a href="#">Home</a><a href="#">Heritage Sites</a><a href="#">Explore</a><a href="#">About us</a><a href="#">Events</a><a href="#">Gallery</a></nav>
    <a class="btn" href="#">Register</a>
</header>
<div class="split">
    <div class="left">
        <p class="eyebrow">HeritageTrail · worldwide</p>
        <h1>Heritage<br />Trails</h1>
        <p class="sub">Sites to see. Programmes to join. Facts you can use — eight sites on four continents.</p>
        <div class="actions"><a class="btn" href="#">See what's on</a><a class="ghost" href="#">Explore 8 sites →</a></div>
        <ol class="index">
            <li><b>01</b><span class="n">Angkor Wat</span><span>Cambodia · Temples</span></li>
            <li><b>02</b><span class="n">Petra</span><span>Jordan · Monuments</span></li>
            <li><b>03</b><span class="n">Machu Picchu</span><span>Peru · Monuments</span></li>
            <li><b>04</b><span class="n">Taj Mahal</span><span>India · Monuments</span></li>
        </ol>
    </div>
    <figure class="right">
        <img src="/images/preview/hero.jpg" alt="Preview photograph" />
        <figcaption>Preview photograph — replace with site photography</figcaption>
    </figure>
</div>
<div class="strip">
    <b>What's on</b>
    <span>Sat 07:00 · Temple Walk — Angkor</span>
    <span>20:30 · Petra by Night</span>
    <span>Sun 15:00 · Mughal Marble Talk</span>
    <a href="#">All events →</a>
</div>
</body>
</html>

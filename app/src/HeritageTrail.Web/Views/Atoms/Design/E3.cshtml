@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>E3 — Poster typographic</title>
<style>
    * { box-sizing: border-box; }
    body { margin: 0; background: #f2efe8; color: #14213d; font-family: 'Segoe UI', system-ui, sans-serif; }
    a { color: inherit; text-decoration: none; }
    header { display: flex; justify-content: space-between; align-items: center; padding: 18px 44px; border-bottom: 1px solid rgb(20 33 61 / .18); }
    .brand { font-family: Georgia, serif; font-size: 22px; }
    nav { display: flex; gap: 20px; font-size: 12px; color: rgb(20 33 61 / .7); }
    .btn { background: #14213d; color: #f2efe8; padding: 11px 20px; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; }
    .poster { display: grid; grid-template-columns: 1.25fr .75fr; gap: 40px; padding: 52px 44px 40px; align-items: end; }
    .kicker { font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: #c8a24a; margin: 0 0 18px; }
    h1 { font-family: Georgia, serif; font-size: clamp(76px, 10vw, 150px); line-height: .84; margin: 0; font-weight: 400; letter-spacing: -.02em; }
    .tag { margin: 22px 0 0; font-size: 13px; letter-spacing: .18em; text-transform: uppercase; color: rgb(20 33 61 / .65); }
    .idx { border-top: 1px solid rgb(20 33 61 / .3); }
    .idx a { display: grid; grid-template-columns: 34px 1fr auto; gap: 12px; padding: 13px 0; border-bottom: 1px solid rgb(20 33 61 / .16); align-items: baseline; }
    .idx b { font-size: 11px; letter-spacing: .1em; color: #c8a24a; font-weight: 400; }
    .idx .n { font-family: Georgia, serif; font-size: 20px; }
    .idx span { font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: rgb(20 33 61 / .55); }
    .band { height: 360px; overflow: hidden; position: relative; }
    .band img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .band figcaption { position: absolute; left: 44px; bottom: 16px; color: #f2efe8; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; background: rgb(20 33 61 / .7); padding: 5px 10px; }
    .events { display: grid; grid-template-columns: 1fr 1fr; gap: 0 48px; padding: 44px; }
    .ev { display: grid; grid-template-columns: 130px 1fr; gap: 20px; padding: 18px 0; border-top: 1px solid rgb(20 33 61 / .22); align-items: baseline; }
    .ev .date { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: #c8a24a; }
    .ev .t { font-family: Georgia, serif; font-size: 26px; }
    .ev .m { font-size: 12px; color: rgb(20 33 61 / .6); margin-top: 4px; }
</style>
</head>
<body>
<header>
    <a class="brand" href="#">HeritageTrail</a>
    <nav><a href="#">Home</a><a href="#">Heritage Sites</a><a href="#">Explore</a><a href="#">About us</a><a href="#">Events</a><a href="#">Gallery</a></nav>
    <a class="btn" href="#">Register</a>
</header>
<section class="poster">
    <div>
        <p class="kicker">Field guide · worldwide</p>
        <h1>HERITAGE<br />TRAILS</h1>
        <p class="tag">Sites · Walks · Exhibitions · Membership</p>
    </div>
    <div class="idx">
        <a href="#"><b>01</b><span class="n">Angkor Wat</span><span>Cambodia</span></a>
        <a href="#"><b>02</b><span class="n">Petra</span><span>Jordan</span></a>
        <a href="#"><b>03</b><span class="n">Machu Picchu</span><span>Peru</span></a>
        <a href="#"><b>04</b><span class="n">Taj Mahal</span><span>India</span></a>
        <a href="#"><b>→</b><span class="n">All 8 sites</span><span>Explore</span></a>
    </div>
</section>
<figure class="band">
    <img src="/images/preview/hero.jpg" alt="Preview photograph" />
    <figcaption>Preview photograph — replace with site photography</figcaption>
</figure>
<section class="events">
    <div class="ev"><span class="date">Sat 07:00</span><div><div class="t">Temple Walk — Angkor</div><div class="m">Angkor Wat west causeway</div></div></div>
    <div class="ev"><span class="date">Sat 20:30</span><div><div class="t">Petra by Night</div><div class="m">The Siq, Petra</div></div></div>
    <div class="ev"><span class="date">Sun 15:00</span><div><div class="t">Mughal Marble Talk</div><div class="m">Agra heritage centre</div></div></div>
    <div class="ev"><span class="date">14th lunar</span><div><div class="t">Lantern Night — Hội An</div><div class="m">An Hội island</div></div></div>
</section>
</body>
</html>

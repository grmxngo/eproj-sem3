@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>D3 — Documentary paper</title>
<style>
    * { box-sizing: border-box; }
    body { margin: 0; background: #f6f2ea; color: #141414; font-family: 'Segoe UI', system-ui, sans-serif; }
    a { color: inherit; text-decoration: none; }
    header { display: flex; justify-content: space-between; align-items: center; padding: 20px 48px; border-bottom: 1px solid #d8d2c4; }
    .brand { font-family: Georgia, serif; font-size: 22px; }
    nav { display: flex; gap: 24px; font-size: 13px; color: #555; }
    nav a:hover { color: #141414; }
    .register { font-size: 12px; letter-spacing: .14em; color: #b03a1c; border-bottom: 1px solid #b03a1c; padding-bottom: 2px; }
    .hero-img { height: 420px; overflow: hidden; }
    .hero-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .caption { padding: 8px 48px; font-size: 11px; color: #777; font-style: italic; }
    .hero-copy { padding: 30px 48px 8px; max-width: 1100px; }
    .eyebrow { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: #b03a1c; margin: 0 0 14px; }
    h1 { font-family: Georgia, serif; font-size: clamp(40px, 5.2vw, 72px); line-height: 1.02; margin: 0 0 18px; font-weight: 400; }
    .lede { font-size: 17px; line-height: 1.55; color: #555; max-width: 52ch; margin: 0 0 24px; }
    .actions { display: flex; gap: 18px; align-items: center; padding-bottom: 24px; }
    .btn { background: #141414; color: #f6f2ea; padding: 13px 24px; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; }
    .ghost { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; border-bottom: 1px solid #141414; padding-bottom: 3px; }
    .section { padding: 36px 48px; border-top: 1px solid #d8d2c4; max-width: 1280px; margin: 0 auto; }
    .section h2 { font-family: Georgia, serif; font-size: 30px; font-weight: 400; margin: 0 0 20px; }
    .events { display: grid; grid-template-columns: 1fr 1fr; gap: 0 48px; }
    .event { display: grid; grid-template-columns: 96px 1fr; gap: 18px; padding: 14px 0; border-top: 1px solid #d8d2c4; align-items: baseline; }
    .date { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #b03a1c; }
    .title { font-family: Georgia, serif; font-size: 21px; }
    .meta { font-size: 12px; color: #777; margin-top: 3px; }
    .sites { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
    .site img { width: 100%; height: 210px; object-fit: cover; display: block; }
    .site b { display: block; font-family: Georgia, serif; font-weight: 400; font-size: 19px; margin: 10px 0 2px; }
    .site span { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: #777; }
    footer { padding: 22px 48px; border-top: 1px solid #d8d2c4; font-size: 11px; color: #777; display: flex; justify-content: space-between; }
</style>
</head>
<body>
<header>
    <a class="brand" href="#">HeritageTrail</a>
    <nav><a href="#">Heritage Sites</a><a href="#">Events</a><a href="#">Gallery</a><a href="#">About us</a></nav>
    <a class="register" href="#">REGISTER</a>
</header>

<div class="hero-img"><img src="/images/preview/hero.jpg" alt="Heritage landscape — preview placeholder" /></div>
<p class="caption">Placeholder photograph — replace with site photography (treatment pipeline).</p>

<div class="hero-copy">
    <p class="eyebrow">Field guide · worldwide</p>
    <h1>Field notes from heritage sites</h1>
    <p class="lede">What survives, what it means, and how to see it — walks, talks and exhibitions at sites across four continents.</p>
    <div class="actions"><a class="btn" href="#">See what's on</a><a class="ghost" href="#">Explore sites</a></div>
</div>

<section class="section">
    <h2>What's on</h2>
    <div class="events">
        <div class="event"><span class="date">Sat 07:00</span><div><div class="title">Temple Walk — Angkor</div><div class="meta">Angkor Wat west causeway</div></div></div>
        <div class="event"><span class="date">Sat 20:30</span><div><div class="title">Petra by Night</div><div class="meta">The Siq, Petra</div></div></div>
    </div>
</section>

<section class="section">
    <h2>Sites</h2>
    <div class="sites">
        <a class="site" href="#"><img src="/images/preview/card1.jpg" alt="Angkor — preview" /><b>Angkor Wat</b><span>Temples · Cambodia</span></a>
        <a class="site" href="#"><img src="/images/preview/card2.jpg" alt="Petra — preview" /><b>Petra</b><span>Monuments · Jordan</span></a>
        <a class="site" href="#"><img src="/images/preview/card3.jpg" alt="Machu Picchu — preview" /><b>Machu Picchu</b><span>Monuments · Peru</span></a>
    </div>
</section>

<footer><span>HeritageTrail</span><span>Preview — placeholder photos</span></footer>
</body>
</html>

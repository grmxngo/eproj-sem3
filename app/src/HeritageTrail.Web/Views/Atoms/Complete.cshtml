@using HeritageTrail.Web.Services
@inject TokenProvider Tokens
@{
    Layout = null;
    var color = Tokens.Node("color")!.AsObject();
    var fs = Tokens.Node("fluid")!["fs"]!.AsObject();
    var space = Tokens.Node("fluid")!["space"]!.AsObject();
    var radius = Tokens.Node("radius")!.AsObject();
    var motion = Tokens.Node("motion")!.AsObject();
    string S(System.Text.Json.Nodes.JsonNode? n) => n is System.Text.Json.Nodes.JsonValue v ? v.GetValue<string>() : "";
    string Kebab(string s) => CssNaming.Kebab(s);
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>A-ALL · Complete atom set (priority order)</title>
<style>@Html.Raw(Tokens.ToCss())</style>
<style>
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--color-bg); color: var(--color-ink); font-family: var(--font-body); font-size: var(--fs-body); }
    .sheet-bar { display: flex; gap: 16px; align-items: baseline; padding: 12px 28px; border-bottom: 1px solid var(--color-border); background: var(--color-surface); font-size: var(--fs-small); }
    .sheet-bar b { font-family: var(--font-display); font-weight: 400; font-size: var(--fs-h3); }
    main { padding: 24px 28px 48px; }
    .block { margin-bottom: 28px; }
    .block h2 { font-family: var(--font-mono); font-size: var(--fs-small); letter-spacing: .12em; text-transform: uppercase; color: var(--color-accent); margin: 0 0 10px; }
    .cells { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; }
    .cell { border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); padding: 14px; }
    .cell .name { font-family: var(--font-mono); font-size: 10px; color: var(--color-ink-muted); letter-spacing: .06em; margin: 0 0 8px; }
    .cell .demo { display: flex; flex-direction: column; gap: 8px; }
    .row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    /* foundations */
    .swatches { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; }
    .sw .c { height: 44px; border-radius: var(--radius-sm); border: 1px solid var(--color-border); }
    .sw span { font-family: var(--font-mono); font-size: 9px; color: var(--color-ink-muted); }
    .scale div { display: flex; align-items: baseline; gap: 10px; }
    .scale b { font-weight: 400; white-space: nowrap; }
    .scale span { font-family: var(--font-mono); font-size: 10px; color: var(--color-ink-muted); }
    .ladder { display: flex; flex-direction: column; gap: 5px; }
    .ladder div { display: flex; align-items: center; gap: 8px; }
    .ladder i { display: block; height: 9px; background: var(--color-accent); opacity: .75; border-radius: 1px; }
    .ladder span { font-family: var(--font-mono); font-size: 9px; color: var(--color-ink-muted); }
    /* atoms */
    .site-card { max-width: 260px; }
    .site-card .card-media { height: 120px; background: linear-gradient(150deg, var(--color-surface-raised), var(--color-surface)); }
    .tile { max-width: 220px; }
    .tile .art { height: 120px; background: linear-gradient(150deg, var(--color-surface-raised), var(--color-surface)); }
    .empty { border: 1px dashed var(--color-border); padding: 16px; color: var(--color-ink-muted); text-align: center; }
    .notice { border: 1px solid var(--color-accent); background: color-mix(in srgb, var(--color-accent) 10%, transparent); padding: 10px 12px; font-size: var(--fs-small); }
    .toast { background: var(--color-ink); color: var(--color-bg); padding: 10px 14px; font-size: var(--fs-small); border-radius: var(--radius-sm); }
    /* forms */
    .field { display: flex; flex-direction: column; gap: 4px; font-size: var(--fs-small); }
    .field input, .field select, .field textarea { padding: var(--space-xs) var(--space-sm); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg); color: var(--color-ink); font: inherit; }
    .field .err { color: var(--color-danger); font-size: var(--fs-micro); }
    .field .help { color: var(--color-ink-muted); font-size: var(--fs-micro); }
    .check { display: flex; gap: 8px; align-items: center; font-size: var(--fs-small); }
    /* identity */
    .logo { width: 64px; height: 64px; color: var(--color-accent); }
    .wordmark { font-family: var(--font-display); font-size: var(--fs-h3); }
    /* admin */
    .admin-top { display: flex; justify-content: space-between; align-items: center; background: var(--color-ink); color: var(--color-bg); padding: 10px 14px; font-size: var(--fs-small); }
    .side-item { padding: 8px 10px; border-left: 2px solid transparent; font-size: var(--fs-small); color: var(--color-ink-muted); }
    .side-item.active { border-left-color: var(--color-accent); color: var(--color-ink); background: var(--color-surface); }
    .stat { background: var(--color-surface); border: 1px solid var(--color-border); padding: 12px 14px; }
    .stat b { display: block; font-family: var(--font-display); font-size: var(--fs-h2); font-weight: 400; }
    .stat span { font-size: var(--fs-micro); letter-spacing: .1em; text-transform: uppercase; color: var(--color-ink-muted); }
    .table { width: 100%; border-collapse: collapse; font-size: var(--fs-small); }
    .table th { text-align: left; font-size: var(--fs-micro); letter-spacing: .1em; text-transform: uppercase; color: var(--color-ink-muted); padding: 6px 8px; border-bottom: 1px solid var(--color-border); }
    .table td { padding: 8px; border-bottom: 1px solid var(--color-border); }
    .pager { display: flex; gap: 6px; font-size: var(--fs-small); }
    .pager span { padding: 3px 8px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
    .pager .on { background: var(--color-accent); color: var(--color-on-accent); border-color: var(--color-accent); }
    .dialog { border: 1px solid var(--color-border); background: var(--color-bg); border-radius: var(--radius-md); padding: 16px; box-shadow: var(--shadow-md); max-width: 320px; }
    .dialog h3 { margin: 0 0 6px; font-family: var(--font-display); font-weight: 400; font-size: var(--fs-h3); }
    .dialog p { margin: 0 0 12px; font-size: var(--fs-small); color: var(--color-ink-muted); }
</style>
</head>
<body>
<div class="sheet-bar"><b>A-ALL · Complete atom set</b><span>thứ tự: foundations → content → interaction → identity/motion → admin</span></div>
<main>

<section class="block">
    <h2>0 · Foundations — tokens (đã duyệt)</h2>
    <div class="cells">
        <div class="cell" style="grid-column: span 2">
            <p class="name">color roles</p>
            <div class="swatches">
                @foreach (var (k, v) in color)
                {
                    <div class="sw"><div class="c" style="background:@S(v)"></div><span>@Kebab(k)</span></div>
                }
            </div>
        </div>
        <div class="cell">
            <p class="name">type scale</p>
            <div class="scale">
                @foreach (var (k, v) in fs)
                {
                    <div><b style="font-size:@S(v)">Ag</b><span>fs-@k</span></div>
                }
            </div>
        </div>
        <div class="cell">
            <p class="name">spacing ladder</p>
            <div class="ladder">
                @foreach (var (k, v) in space)
                {
                    <div><i style="width:@S(v)"></i><span>@k</span></div>
                }
            </div>
        </div>
        <div class="cell">
            <p class="name">radius · motion</p>
            <div class="row">
                @foreach (var (k, v) in radius)
                {
                    <span style="display:inline-block;width:44px;height:32px;border:1px solid var(--color-accent);border-radius:@S(v)"></span>
                }
            </div>
            <div class="ladder" style="margin-top:10px">
                @foreach (var (k, v) in motion)
                {
                    <div><span>@k</span><span>@S(v)</span></div>
                }
            </div>
        </div>
    </div>
</section>

<section class="block">
    <h2>1 · Content atoms</h2>
    <div class="cells">
        <div class="cell"><p class="name">chip · category</p><div class="demo"><div class="row"><span class="chip">Temples</span><span class="chip">Forts</span><span class="chip chip-sm">UNESCO 1999</span></div></div></div>
        <div class="cell"><p class="name">badge · date</p><div class="demo"><div class="row"><span class="event-date"><span class="event-day" style="font-size:var(--fs-h2);color:var(--color-accent)">21</span><span class="event-month">Nov · 07:00</span></span></div></div></div>
        <div class="cell"><p class="name">site card</p>
            <div class="demo"><a class="site-card" href="#"><div class="card-media"></div><div class="card-body"><p class="card-kicker">Temples · Cambodia</p><h2 class="card-title">Angkor Wat</h2><p class="card-fact">12th-c. temple; moat 190 m wide.</p></div></a></div>
        </div>
        <div class="cell"><p class="name">event card (E3)</p>
            <div class="demo"><span class="band-card band-card-typo" style="color:var(--color-ink)"><span class="band-day" style="color:var(--color-accent)">21</span><span class="band-month" style="color:var(--color-ink-muted)">NOV · 07:00</span><h3 class="event-title">Temple Walk — Angkor</h3><p class="event-meta">Angkor Wat west causeway</p></span></div>
        </div>
        <div class="cell"><p class="name">gallery tile</p>
            <div class="demo"><figure class="tile"><div class="art"></div><figcaption class="card-fact">Lantern Night — preview</figcaption></figure></div>
        </div>
        <div class="cell"><p class="name">breadcrumb · section head</p>
            <div class="demo"><nav class="breadcrumb" style="margin:0"><a href="#">Home</a> / <a href="#">Heritage Sites</a> / <span>Angkor Wat</span></nav>
                <div class="section-head" style="margin:0"><h2 style="font-size:var(--fs-h3)">What's on</h2><a href="#">All →</a></div></div>
        </div>
        <div class="cell"><p class="name">empty · notice · toast</p>
            <div class="demo"><p class="empty" style="margin:0">No heritage site found.</p><div class="notice">Interest recorded.</div><div class="toast">Invitation sent.</div></div>
        </div>
    </div>
</section>

<section class="block">
    <h2>2 · Interaction atoms</h2>
    <div class="cells">
        <div class="cell"><p class="name">text input · error state</p>
            <div class="demo"><label class="field">Email<input type="email" placeholder="you@email.com" /><span class="help">We use it only for programme updates.</span></label>
            <label class="field">Password<input type="password" value="1234" /><span class="err">Password must be at least 8 characters.</span></label></div>
        </div>
        <div class="cell"><p class="name">select · textarea</p>
            <div class="demo"><label class="field">Category<select><option>Temples</option><option>Forts</option></select></label>
            <label class="field">Query<textarea rows="2" placeholder="Your question"></textarea></label></div>
        </div>
        <div class="cell"><p class="name">checkbox · buttons</p>
            <div class="demo"><label class="check"><input type="checkbox" checked /> Remember me on this device</label>
            <div class="row"><span class="btn btn-primary">Plan a visit</span><span class="btn btn-ghost">Explore sites</span></div>
            <div class="row"><span class="btn btn-primary" style="opacity:.5;pointer-events:none">Disabled</span><a href="#" style="color:var(--color-accent);font-size:var(--fs-small)">Inline link →</a></div></div>
        </div>
        <div class="cell"><p class="name">nav item · footer link</p>
            <div class="demo"><div class="row" style="font-size:var(--fs-small)"><a href="#" style="color:var(--color-ink)">Home</a><a href="#" style="color:var(--color-accent)">Events</a><a href="#" style="color:var(--color-ink-muted)">Gallery</a></div>
            <div class="row" style="font-size:var(--fs-small);color:var(--color-ink-muted)"><a href="#" style="color:var(--color-ink-muted)">Contact</a><a href="#" style="color:var(--color-ink-muted)">About us</a></div></div>
        </div>
    </div>
</section>

<section class="block">
    <h2>3 · Identity &amp; motion</h2>
    <div class="cells">
        <div class="cell"><p class="name">logo mark (trail, draws on load)</p>
            <div class="demo">
                <svg class="logo" viewBox="0 0 64 64" aria-label="HeritageTrail mark">
                    <path d="M8 50 C 20 40, 12 26, 30 24 S 50 30, 56 12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-dasharray="120" stroke-dashoffset="120">
                        <animate attributeName="stroke-dashoffset" from="120" to="0" dur="1.1s" begin="0.2s" fill="freeze" />
                    </path>
                    <circle cx="8" cy="50" r="4" fill="currentColor" />
                    <circle cx="56" cy="12" r="4" fill="currentColor" />
                    <circle cx="32" cy="24" r="3" fill="currentColor" />
                </svg>
            </div>
        </div>
        <div class="cell"><p class="name">wordmark · favicon</p>
            <div class="demo"><span class="wordmark">HeritageTrail</span>
                <div class="row"><span style="display:inline-block;width:24px;height:24px;background:var(--color-accent);border-radius:var(--radius-sm)"></span><span style="display:inline-block;width:24px;height:24px;border:2px solid var(--color-accent);border-radius:50%"></span></div></div>
        </div>
        <div class="cell"><p class="name">motion rules</p>
            <div class="demo" style="font-size:var(--fs-small);color:var(--color-ink-muted)">
                hover 120ms ease · state 200ms easeOut · panel 320ms easeOut · hero 480ms easeOut.<br />
                reduced-motion: transitions → .01ms, no transforms.
            </div>
        </div>
    </div>
</section>

<section class="block">
    <h2>4 · Admin atoms</h2>
    <div class="cells">
        <div class="cell" style="grid-column: span 2"><p class="name">admin topbar · sidebar item</p>
            <div class="demo">
                <div class="admin-top"><span>HeritageTrail Admin</span><span>admin@heritagetrail.local</span></div>
                <div style="display:grid;grid-template-columns:160px 1fr;gap:10px"><div><div class="side-item active">Sites</div><div class="side-item">Events</div><div class="side-item">Gallery</div><div class="side-item">Members</div><div class="side-item">Queries</div></div><div class="stat"><b>8</b><span>heritage sites</span></div></div>
            </div>
        </div>
        <div class="cell" style="grid-column: span 2"><p class="name">table row + actions · filter + pagination</p>
            <div class="demo">
                <table class="table"><tr><th>Site</th><th>Category</th><th></th></tr>
                    <tr><td>Angkor Wat</td><td>Temples</td><td><a href="#" style="color:var(--color-accent)">Edit</a></td></tr>
                    <tr><td>Petra</td><td>Monuments</td><td><a href="#" style="color:var(--color-accent)">Edit</a></td></tr></table>
                <div class="row"><span class="chip">All</span><span class="chip">Temples</span><span class="pager"><span class="on">1</span><span>2</span><span>3</span></span></div>
            </div>
        </div>
        <div class="cell"><p class="name">confirm dialog</p>
            <div class="dialog"><h3>Delete this event?</h3><p>Interests recorded for this event will be removed.</p><div class="row"><span class="btn btn-primary" style="background:var(--color-danger)">Delete</span><span class="btn btn-ghost">Cancel</span></div></div>
        </div>
    </div>
</section>

</main>
</body>
</html>

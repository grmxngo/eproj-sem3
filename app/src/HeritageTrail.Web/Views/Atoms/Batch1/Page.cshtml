@using System.Text.Json.Nodes
@using HeritageTrail.Web.Services
@inject TokenProvider Tokens
@{
    Layout = null;
    var p = (JsonObject)ViewData["Mock"]!;
    var color = p["color"]!.AsObject();
    var sb = new System.Text.StringBuilder();
    foreach (var (k, v) in color)
    {
        if (v is JsonValue jv && jv.GetValueKind() == System.Text.Json.JsonValueKind.String)
        {
            sb.Append("--color-").Append(CssNaming.Kebab(k)).Append(':').Append(jv.GetValue<string>()).Append(';');
        }
    }
    string S(JsonNode? n, string fallback = "") => n is JsonValue v && v.GetValueKind() == System.Text.Json.JsonValueKind.String ? v.GetValue<string>() : fallback;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@S(p["id"]) · @S(p["name"]) — full page</title>
    <style>@Html.Raw(Tokens.ToCss())</style>
    <style>:root{@Html.Raw(sb.ToString())}</style>
    <link rel="stylesheet" href="/css/atoms.css" />
    <style>
        .hero { padding-top: var(--space-lg); }
        .next-up {
            background: var(--color-surface); border: 1px solid var(--color-border);
            border-radius: var(--radius-md); padding: var(--space-md);
            display: flex; flex-direction: column; gap: var(--space-xs); box-shadow: var(--shadow-sm);
        }
        .next-up .tag { font-size: var(--fs-micro); letter-spacing: .14em; text-transform: uppercase; color: var(--color-accent); margin: 0; }
        .next-up h2 { font-family: var(--font-display); font-size: var(--fs-h2); margin: 0; font-weight: 400; }
        .next-up .meta { margin: 0; color: var(--color-ink-muted); font-size: var(--fs-small); }
        .searchbar {
            display: flex; gap: var(--space-sm); align-items: center; flex-wrap: wrap;
            padding: var(--space-md) 0; margin-top: var(--space-sm);
            border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);
        }
        .searchbar input {
            flex: 1; min-width: 14rem; padding: var(--space-xs) var(--space-sm);
            border: 1px solid var(--color-border); border-radius: var(--radius-sm);
            background: var(--color-surface); color: var(--color-ink); font: inherit; font-size: var(--fs-small);
        }
        .section-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-md); margin: var(--space-xl) 0 var(--space-md); }
        .section-head h2 { font-family: var(--font-display); font-size: var(--fs-h2); margin: 0; font-weight: 400; }
        .section-head a { font-size: var(--fs-small); color: var(--color-accent); text-decoration: none; }
        .about-block {
            display: grid; grid-template-columns: 1fr auto; gap: var(--space-md); align-items: center;
            padding: var(--space-lg); margin: var(--space-xl) 0;
            background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md);
        }
        .about-block h2 { font-family: var(--font-display); font-size: var(--fs-h2); margin: 0 0 var(--space-xs); font-weight: 400; }
        .about-block p { margin: 0; color: var(--color-ink-muted); font-size: var(--fs-small); }
        .gallery-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-sm); margin-bottom: var(--space-xl); }
        .tile { margin: 0; border: 1px solid var(--color-border); border-radius: var(--radius-sm); overflow: hidden; }
        .tile .art { aspect-ratio: 4 / 3; background:
            radial-gradient(90% 80% at 20% 15%, color-mix(in srgb, var(--color-accent) 18%, transparent), transparent 60%),
            linear-gradient(150deg, var(--color-surface-raised), var(--color-surface)); }
        .tile figcaption { padding: var(--space-xs) var(--space-sm); font-size: var(--fs-micro); color: var(--color-ink-muted); }
    </style>
</head>
<body>
    <div class="specimen-bar">
        <span class="spec-id">@S(p["id"]) · @S(p["name"])</span>
        <span class="spec-desc">trang đầy đủ như client · dữ liệu mẫu · logo placeholder (Batch 2)</span>
    </div>

    <div class="page">
        <header class="site-head">
            <a class="wordmark" href="#">HeritageTrail</a>
            <nav class="nav-stub" aria-label="Primary">
                <a href="#">Home</a>
                <a href="#">Heritage Sites</a>
                <a href="#">Explore</a>
                <a href="#">About us</a>
                <a href="#">Events</a>
                <a href="#">Gallery</a>
                <a class="nav-register" href="#">REGISTER</a>
            </nav>
        </header>

        <section class="hero">
            <div class="hero-copy">
                <p class="eyebrow">HeritageTrail · Vietnam</p>
                <h1 class="display">Heritage sites, walks and exhibitions</h1>
                <p class="lede">Browse sites by category, join upcoming programmes, see what we have run.</p>
                <div class="action-row">
                    <a class="btn btn-primary" href="#upcoming">See what's on</a>
                    <a class="btn btn-ghost" href="#sites">Explore sites</a>
                </div>
            </div>
            <aside class="next-up">
                <p class="tag">Next up</p>
                <h2>Lantern Night — Hội An</h2>
                <p class="meta">14th lunar night · An Hội island</p>
                <div><a class="btn btn-primary" href="#">Interested</a></div>
            </aside>
        </section>

        <div class="searchbar">
            <input type="search" placeholder="Search heritage sites" aria-label="Search heritage sites" />
            <span class="chips" style="margin:0">
                <span class="chip">Forts</span>
                <span class="chip">Palaces</span>
                <span class="chip">Museums</span>
                <span class="chip">Temples</span>
                <span class="chip">Monuments</span>
            </span>
        </div>

        <section id="upcoming">
            <div class="section-head">
                <h2>Upcoming programmes</h2>
                <a href="#">All events →</a>
            </div>
            <div class="event-list">
                <article class="event-row">
                    <div class="event-date"><span class="event-day">Sat</span><span class="event-month">07:00</span></div>
                    <div class="event-body"><h3 class="event-title">Cham Tower Walk — Mỹ Sơn</h3></div>
                    <span class="event-cta">Interested</span>
                </article>
                <article class="event-row">
                    <div class="event-date"><span class="event-day">Sun</span><span class="event-month">15:00</span></div>
                    <div class="event-body"><h3 class="event-title">Heritage Talk — Thăng Long</h3></div>
                    <span class="event-cta">Interested</span>
                </article>
                <article class="event-row">
                    <div class="event-date"><span class="event-day">14</span><span class="event-month">lunar</span></div>
                    <div class="event-body"><h3 class="event-title">Lantern Night — Hội An</h3></div>
                    <span class="event-cta">Interested</span>
                </article>
            </div>
        </section>

        <section id="sites">
            <div class="section-head">
                <h2>Featured sites</h2>
                <a href="#">Explore all →</a>
            </div>
            <div class="cards">
                <article class="site-card">
                    <div class="card-media" aria-hidden="true"></div>
                    <div class="card-body">
                        <p class="card-kicker">Temples</p>
                        <h2 class="card-title">Mỹ Sơn Sanctuary</h2>
                        <p class="card-fact">4th–13th c. Chăm brick towers; UNESCO 1999.</p>
                    </div>
                </article>
                <article class="site-card">
                    <div class="card-media" aria-hidden="true"></div>
                    <div class="card-body">
                        <p class="card-kicker">Palaces</p>
                        <h2 class="card-title">Hoàng thành Thăng Long</h2>
                        <p class="card-fact">Imperial citadel from the 11th century.</p>
                    </div>
                </article>
                <article class="site-card">
                    <div class="card-media" aria-hidden="true"></div>
                    <div class="card-body">
                        <p class="card-kicker">Monuments</p>
                        <h2 class="card-title">Cố đô Huế</h2>
                        <p class="card-fact">143 buildings survive of about 600.</p>
                    </div>
                </article>
            </div>
        </section>

        <section class="about-block">
            <div>
                <h2>What we do</h2>
                <p>We run heritage walks, exhibitions and awareness programmes — and publish the sites behind them.</p>
            </div>
            <a class="btn btn-ghost" href="#">About us</a>
        </section>

        <section>
            <div class="section-head">
                <h2>From past programmes</h2>
                <a href="#">Gallery →</a>
            </div>
            <div class="gallery-grid">
                <figure class="tile"><div class="art" aria-hidden="true"></div><figcaption>Lantern Night — Hội An</figcaption></figure>
                <figure class="tile"><div class="art" aria-hidden="true"></div><figcaption>Cham tower walk — Mỹ Sơn</figcaption></figure>
                <figure class="tile"><div class="art" aria-hidden="true"></div><figcaption>Heritage talk — Thăng Long</figcaption></figure>
                <figure class="tile"><div class="art" aria-hidden="true"></div><figcaption>Exhibition — Huế</figcaption></figure>
            </div>
        </section>

        <footer class="site-foot">
            <span>HeritageTrail · heritage walks &amp; exhibitions</span>
            <span class="foot-links"><a href="#">Contact</a><a href="#">Register</a><a href="#">About us</a></span>
        </footer>
    </div>
</body>
</html>

@using System.Text.Json.Nodes
@using HeritageTrail.Web.Services
@{
    Layout = null;
    var palettes = (JsonArray)ViewData["MockPalettes"]!;
    string S(JsonNode? n, string fallback = "") => n is JsonValue v && v.GetValueKind() == System.Text.Json.JsonValueKind.String ? v.GetValue<string>() : fallback;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>A-01 · Palette comparison (4 options)</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { margin: 0; background: #ffffff; color: #1b1b1b; font-family: 'Segoe UI', system-ui, sans-serif; }
        .sheet-bar { display: flex; gap: 14px; align-items: baseline; padding: 12px 28px; border-bottom: 1px solid #e3e3e3; }
        .sheet-tag { font-family: Consolas, monospace; font-size: 13px; color: #8a5a00; letter-spacing: .06em; }
        .sheet-note { font-size: 13px; color: #666; }
        .sheet { display: grid; grid-template-columns: repeat(4, 1fr); }
        .pal { padding: 18px 20px 22px; border-right: 1px solid #e3e3e3; }
        .pal:last-child { border-right: 0; }
        .pal h3 { font-size: 15px; margin: 0 0 2px; }
        .pal .sub { font-size: 12px; color: #777; margin: 0 0 12px; min-height: 30px; }
        .sw-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
        .sw { border: 1px solid #e0e0e0; }
        .sw .c { height: 46px; }
        .sw .t { font-family: Consolas, monospace; font-size: 10px; color: #555; padding: 3px 4px; line-height: 1.25; }
    </style>
</head>
<body>
    <div class="sheet-bar">
        <span class="sheet-tag">A-01 · PALETTE</span>
        <span class="sheet-note">mỗi cột = 1 palette đầy đủ 12 role — chưa có nav/hero/component</span>
    </div>
    <div class="sheet">
        @foreach (var item in palettes)
        {
            var p = item!.AsObject();
            var color = p["color"]!.AsObject();
            <section class="pal">
                <h3>@S(p["id"]) — @S(p["name"])</h3>
                <p class="sub">@S(p["desc"])</p>
                <div class="sw-grid">
                    @foreach (var (k, v) in color)
                    {
                        var hex = S(v);
                        <div class="sw">
                            <div class="c" style="background:@hex"></div>
                            <div class="t">@CssNaming.Kebab(k)<br />@hex</div>
                        </div>
                    }
                </div>
            </section>
        }
    </div>
</body>
</html>

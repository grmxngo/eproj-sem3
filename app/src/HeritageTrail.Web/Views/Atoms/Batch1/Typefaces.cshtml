@{
    Layout = null;
    var fonts = new (string Name, string Stack, string Cat, string Note)[]
    {
        ("Georgia", "'Georgia', 'Times New Roman', serif", "serif · textbook", "nét đầm, khỏe, rất dễ đọc trên màn hình"),
        ("Palatino Linotype", "'Palatino Linotype', 'Book Antiqua', serif", "serif · humanist", "mềm, có chất thư tịch, chữ hoa thanh thoát"),
        ("Cambria", "'Cambria', serif", "serif · screen", "chân thấp, thân chữ chắc, số liệu rõ"),
        ("Constantia", "'Constantia', Georgia, serif", "serif · elegant", "tương phản nét cao, sang nhưng không cứng"),
        ("Book Antiqua", "'Book Antiqua', Palatino, serif", "serif · old style", "cổ điển Ý, hợp tiêu đề di sản"),
        ("Garamond", "'Garamond', 'EB Garamond', serif", "serif · classic", "mảnh, sách cũ, cần cỡ lớn để đọc"),
        ("Sitka Text", "'Sitka Text', Georgia, serif", "serif · modern", "thân chữ hiện đại, gần với báo in"),
        ("Segoe UI", "'Segoe UI Variable Text', 'Segoe UI', system-ui, sans-serif", "sans · neutral", "trung tính, an toàn cho form và bảng admin"),
        ("Bahnschrift", "'Bahnschrift', 'DIN Alternate', sans-serif", "sans · grotesk", "kỹ thuật, số liệu, giờ mở cửa rõ"),
        ("Trebuchet MS", "'Trebuchet MS', 'Segoe UI', sans-serif", "sans · humanist", "mềm, thân thiện, hơi cổ"),
        ("Franklin Gothic", "'Franklin Gothic Medium', 'Arial Narrow', sans-serif", "condensed · signage", "đậm, gọn, chất bảng hiệu/bến tàu"),
        ("Rockwell", "'Rockwell', 'Courier New', serif", "slab · display", "chân vuông, mạnh, hợp số liệu và tiêu đề ngắn")
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>A-02 · Typefaces on small components</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { margin: 0; background: #f4f4f2; color: #141414; font-family: 'Segoe UI', system-ui, sans-serif; }
        .sheet-bar { display: flex; gap: 14px; align-items: baseline; padding: 12px 24px; border-bottom: 1px solid #ddd; }
        .sheet-tag { font-family: Consolas, monospace; font-size: 13px; color: #8a5a00; letter-spacing: .06em; }
        .sheet-note { font-size: 13px; color: #666; }
        .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; padding: 18px 24px 28px; }
        .card { background: #fff; border: 1px solid #e0e0e0; border-radius: 6px; padding: 16px 18px; display: flex; flex-direction: column; gap: 8px; }
        .card-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-family: 'Segoe UI', system-ui, sans-serif; }
        .card-head b { font-size: 13px; }
        .card-head span { font-size: 11px; color: #777; }
        .site { margin: 2px 0 0; font-size: 24px; font-weight: 600; line-height: 1.15; }
        .bodyline { margin: 0; font-size: 13px; line-height: 1.45; color: #444; }
        .row { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-top: 2px; }
        .btn { background: #1f1f1f; color: #fff; padding: 6px 12px; border-radius: 3px; font-size: 13px; }
        .link { font-size: 13px; color: #1f1f1f; text-decoration: underline; text-underline-offset: 3px; }
        .chip { border: 1px solid #c9c9c9; border-radius: 999px; padding: 2px 9px; font-size: 11px; color: #444; }
        .date { font-size: 12px; color: #555; }
        .label { font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: #333; }
        .note { font-family: 'Segoe UI', system-ui, sans-serif; font-size: 11px; color: #888; }
    </style>
</head>
<body>
    <div class="sheet-bar">
        <span class="sheet-tag">A-02 · TYPEFACES</span>
        <span class="sheet-note">12 font × cùng cụm component nhỏ (heading, body, button, link, chip, date, label) · chưa chốt màu</span>
    </div>
    <div class="grid">
        @foreach (var f in fonts)
        {
            <div class="card" style="font-family:@f.Stack">
                <div class="card-head"><b>@f.Name</b><span>@f.Cat</span></div>
                <h3 class="site">Angkor Wat</h3>
                <p class="bodyline">Built in the 12th century; the moat runs 190 m wide.</p>
                <div class="row">
                    <span class="btn">Plan a visit</span>
                    <a class="link" href="#">View details →</a>
                </div>
                <div class="row">
                    <span class="chip">Temples</span>
                    <span class="date">Sat · 07:00</span>
                    <span class="label">NEXT UP</span>
                </div>
                <div class="note">@f.Note</div>
            </div>
        }
    </div>
</body>
</html>

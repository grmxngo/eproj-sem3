@using HeritageTrail.Web.Services
@inject TokenProvider Tokens
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Batch 1 — clamp</title>
    <style>@Html.Raw(Tokens.ToCss())</style>
    <link rel="stylesheet" href="/css/atoms.css" />
</head>
<body class="specimen">
    <div class="specimen-bar">
        <span class="spec-id">A-06 · CLAMP</span>
        <span class="spec-name">cùng một nội dung — 360 / 768 / 1440 px</span>
    </div>
    <div class="specimen-wrap">
        @await Html.PartialAsync("~/Views/Atoms/Batch1/_Slice.cshtml")
    </div>
    <div class="clamp-readout" id="readout">…</div>
    <script>
        window.addEventListener('DOMContentLoaded', () => {
            const cs = el => getComputedStyle(el);
            const h1 = document.querySelector('.display');
            const card = document.querySelector('.site-card');
            const hero = document.querySelector('.hero');
            const px = v => Math.round(v * 10) / 10;
            document.getElementById('readout').textContent =
                `viewport ${innerWidth}px · h1 ${px(parseFloat(cs(h1).fontSize))}px · body ${px(parseFloat(cs(document.body).fontSize))}px · hero cols ${cs(hero).gridTemplateColumns.split(' ').length} · card ${Math.round(card.getBoundingClientRect().width)}px`;
        });
    </script>
</body>
</html>

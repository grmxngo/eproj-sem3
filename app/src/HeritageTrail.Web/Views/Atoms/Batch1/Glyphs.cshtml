@using System.Text.Json.Nodes
@{
    Layout = null;
    var items = (JsonArray)ViewData["Typography"]!;
    string S(JsonNode? n, string fallback = "") => n is JsonValue v && v.GetValueKind() == System.Text.Json.JsonValueKind.String ? v.GetValue<string>() : fallback;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>A-02a · Glyph (chữ cái)</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { margin: 0; background: #f6f6f4; color: #111111; font-family: 'Segoe UI', system-ui, sans-serif; }
        .sheet-bar { display: flex; gap: 14px; align-items: baseline; padding: 12px 28px; border-bottom: 1px solid #dddddd; }
        .sheet-tag { font-family: Consolas, monospace; font-size: 13px; color: #8a5a00; letter-spacing: .06em; }
        .sheet-note { font-size: 13px; color: #666; }
        .cols { display: grid; grid-template-columns: repeat(3, 1fr); }
        .col { padding: 26px 30px 34px; border-right: 1px solid #e4e4e4; }
        .col:last-child { border-right: 0; }
        .col h3 { font-size: 14px; margin: 0 0 2px; }
        .col .sub { font-size: 12px; color: #777; margin: 0 0 18px; }
        .glyphs { font-size: 170px; line-height: 1; letter-spacing: .02em; }
        .glyphs .small { display: block; font-size: 52px; margin-top: 10px; letter-spacing: .06em; color: #333; }
        .coverage { margin-top: 18px; font-family: Consolas, monospace; font-size: 12px; color: #555; }
        .coverage b { color: #8a2b1c; }
    </style>
</head>
<body>
    <div class="sheet-bar">
        <span class="sheet-tag">A-02a · GLYPH</span>
        <span class="sheet-note">chỉ chữ cái — chưa màu, chưa layout, chưa component; test luôn dấu tiếng Việt</span>
    </div>
    <div class="cols">
        @foreach (var item in items)
        {
            var t = item!.AsObject();
            var id = S(t["id"]);
            var name = S(t["name"]);
            var desc = S(t["desc"]);
            var display = S(t["display"]);
            var glyphStyle = $"font-family:{display}";
            <section class="col">
                <h3>@id — @name</h3>
                <p class="sub">@desc</p>
                <div class="glyphs" style="@glyphStyle" aria-label="A Đ in @id">A Đ<span class="small">Mỹ Sơn</span></div>
                <div class="coverage">A Đ Mỹ Sơn — kiểm tra dấu tiếng Việt (ỹ, ơ) và nét chữ</div>
            </section>
        }
    </div>
</body>
</html>

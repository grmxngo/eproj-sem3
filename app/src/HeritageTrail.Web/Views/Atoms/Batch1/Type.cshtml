@using System.Text.Json.Nodes
@using HeritageTrail.Web.Services
@inject TokenProvider Tokens
@{
    Layout = null;
    var items = (JsonArray)ViewData["Typography"]!;
    string S(JsonNode? n, string fallback = "") => n is JsonValue v && v.GetValueKind() == System.Text.Json.JsonValueKind.String ? v.GetValue<string>() : fallback;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Batch 1 — Typography</title>
    <style>@Html.Raw(Tokens.ToCss())</style>
    <link rel="stylesheet" href="/css/atoms.css" />
</head>
<body class="specimen">
    <div class="specimen-bar">
        <span class="spec-id">A-02 · TYPOGRAPHY</span>
        <span class="spec-name">3 lựa chọn — font hệ thống tương đương, bản chọn sẽ self-host</span>
    </div>
    <div class="specimen-wrap">
        <div class="type-grid">
            @foreach (var item in items)
            {
                var t = item!.AsObject();
                var id = S(t["id"]);
                var name = S(t["name"]);
                var desc = S(t["desc"]);
                var note = S(t["fontNote"]);
                var typeVars = $"--font-display:{S(t["display"])};--font-body:{S(t["body"])}";
                <section class="type-col" style="@typeVars">
                    <header class="type-head">
                        <span class="spec-id">@id</span>
                        <h2 class="type-name">@name</h2>
                        <p class="type-desc">@desc</p>
                    </header>
                    <p class="eyebrow">Heritage Trail · Central Vietnam</p>
                    <h1 class="display type-sample">Mỹ Sơn: four centuries of Cham towers, one valley</h1>
                    <p class="lede">
                        The brick towers were built between the 4th and 13th centuries by the Chăm
                        kingdoms; UNESCO listed the site in 1999.
                    </p>
                    <div class="action-row">
                        <span class="btn btn-primary">Plan a visit</span>
                        <span class="btn btn-ghost">Explore sites</span>
                    </div>
                    <dl class="fact-row">
                        <div class="fact"><dt>UNESCO</dt><dd>1999</dd></div>
                        <div class="fact"><dt>From Da Nang</dt><dd>70 km</dd></div>
                    </dl>
                    <p class="type-note">@note</p>
                </section>
            }
        </div>
    </div>
</body>
</html>

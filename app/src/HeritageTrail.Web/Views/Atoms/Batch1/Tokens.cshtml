@using System.Text.Json.Nodes
@using HeritageTrail.Web.Services
@inject TokenProvider Tokens
@{
    Layout = null;
    var radii = (JsonArray)ViewData["Radii"]!;
    var space = Tokens.Node("fluid")!["space"]!.AsObject();
    var motion = Tokens.Node("motion")!.AsObject();
    string S(JsonNode? n, string fallback = "") => n is JsonValue v && v.GetValueKind() == System.Text.Json.JsonValueKind.String ? v.GetValue<string>() : fallback;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Batch 1 — Spacing / Radius / Motion</title>
    <style>@Html.Raw(Tokens.ToCss())</style>
    <link rel="stylesheet" href="/css/atoms.css" />
</head>
<body class="specimen">
    <div class="specimen-bar">
        <span class="spec-id">A-03 · SPACING</span>
        <span class="spec-name">A-04 · RADIUS / ELEVATION</span>
        <span class="spec-name">A-05 · MOTION</span>
    </div>
    <div class="specimen-wrap">
        <section class="spec-section">
            <h2>A-03 · Spacing ladder — một thang duy nhất, fluid bằng clamp()</h2>
            <div class="ladder">
                @foreach (var (name, value) in space)
                {
                    <span class="ladder-name">--space-@name</span>
                    <span class="ladder-bar" style="width: var(--space-@name)"></span>
                }
            </div>
        </section>

        <section class="spec-section">
            <h2>A-04 · Radius — chọn 1 hướng, áp cho toàn bộ atom</h2>
            <div class="radius-grid">
                @foreach (var item in radii)
                {
                    var r = item!.AsObject();
                    var id = S(r["id"]);
                    var rname = S(r["name"]);
                    var md = S(r["md"]);
                    var radiusStyle = $"border-radius:{md}";
                    <div class="radius-card">
                        <span class="spec-id">@id · @rname</span>
                        <div class="radius-swatch" style="@radiusStyle"></div>
                        <span class="ladder-name">sm @S(r["sm"]) · md @md · lg @S(r["lg"])</span>
                    </div>
                }
            </div>
            <div class="shadow-grid">
                <div class="shadow-card" style="box-shadow:var(--shadow-sm)">shadow-sm — the edge cue, not decoration</div>
                <div class="shadow-card" style="box-shadow:var(--shadow-md)">shadow-md — cards on hover / sticky bar</div>
                <div class="shadow-card" style="box-shadow:var(--shadow-lg)">shadow-lg — dialogs only</div>
            </div>
        </section>

        <section class="spec-section">
            <h2>A-05 · Motion — 4 nhịp, 3 easing, tắt hoàn toàn khi reduced-motion</h2>
            <div class="motion-grid">
                @foreach (var (name, value) in motion)
                {
                    <span class="motion-name">--motion-@name</span>
                    <span class="ladder-name">@S(value)</span>
                }
            </div>
            <p class="lede" style="margin-top: var(--space-md)">
                Hover: 120ms ease · state: 200ms easeOut · panel: 320ms easeOut · hero reveal: 480ms easeOut.
                Tất cả transform dừng khi trình duyệt bật reduced-motion.
            </p>
        </section>
    </div>
</body>
</html>

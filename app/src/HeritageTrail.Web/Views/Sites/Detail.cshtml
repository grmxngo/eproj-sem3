@using HeritageTrail.Web.Models
@{
    var site = (HeritageSite)ViewData["Site"]!;
    var events = (List<Event>)ViewData["Events"]!;
    ViewData["Title"] = site.Name;
}
<nav class="breadcrumb">
    <a href="/">Home</a> / <a href="/heritage-sites">Heritage Sites</a> / <span>@site.Name</span>
</nav>

<article class="detail">
    <p class="card-kicker">@site.Category</p>
    <h1 class="page-title">@site.Name</h1>
    <p class="detail-meta">@site.Location</p>
    <div class="detail-media media-art" aria-hidden="true"></div>

    <section>
        <h2>Historical background</h2>
        <p>@site.HistoricalBackground</p>
    </section>
    <section>
        <h2>Architecture and significance</h2>
        <p>@site.ArchitectureSignificance</p>
    </section>
    @if (!string.IsNullOrWhiteSpace(site.CulturalBackground))
    {
        <section>
            <h2>Cultural background</h2>
            <p>@site.CulturalBackground</p>
        </section>
    }

    @if (events.Count > 0)
    {
        <section>
            <h2>Programmes at this site</h2>
            <div class="event-list">
                @foreach (var ev in events)
                {
                    <a class="event-row" href="/events/@ev.Slug">
                        <div class="event-date">
                            <span class="event-day">@ev.StartDate.ToString("ddd")</span>
                            <span class="event-month">@ev.StartDate.ToString("HH:mm")</span>
                        </div>
                        <div class="event-body">
                            <h3 class="event-title">@ev.Title</h3>
                            <p class="event-meta">@ev.Venue</p>
                        </div>
                        <span class="event-cta">View →</span>
                    </a>
                }
            </div>
        </section>
    }

    <section class="invite">
        <h2>Invite a friend</h2>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" action="/heritage-sites/@site.Slug/invite" class="inline-form">
                @Html.AntiForgeryToken()
                <input name="email" type="email" placeholder="friend@email.com" required />
                <button class="btn btn-primary" type="submit">Send invite</button>
            </form>
        }
        else
        {
            <p><a href="/auth/login?returnUrl=/heritage-sites/@site.Slug">Log in</a> to invite a friend.</p>
        }
    </section>
</article>

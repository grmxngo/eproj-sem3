@using HeritageTrail.Web.Services
@inject TokenProvider Tokens
@inject EnvironmentInfo Env
@{
    var title = ViewData["Title"] as string ?? "HeritageTrail";
    var desc = ViewData["Description"] as string ??
        "Heritage walks, talks and exhibitions at heritage sites worldwide — facts, stories, footage and programmes.";
}
@functions {
    string NavClass(string path) =>
        path == "/"
            ? (Context.Request.Path == "/" ? "on" : "")
            : (Context.Request.Path.StartsWithSegments(path) ? "on" : "");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title — HeritageTrail</title>
    <meta name="description" content="@desc" />
    <meta property="og:title" content="@title — HeritageTrail" />
    <meta property="og:description" content="@desc" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/preview/hero.jpg" />
    @if (Env.IsStaging)
    {
        <meta name="robots" content="noindex" />
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>@Html.Raw(Tokens.ToCss())</style>
    <link rel="stylesheet" href="/css/atoms.css" />
    @if (ViewData["PaletteVars"] is string paletteVars)
    {
        <style>:root{@Html.Raw(paletteVars)}</style>
    }
    @if (ViewData["TypeVars"] is string typeVars)
    {
        <style>:root{@Html.Raw(typeVars)}</style>
    }
    @if (ViewData["RadiusVars"] is string radiusVars)
    {
        <style>:root{@Html.Raw(radiusVars)}</style>
    }
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
@if (Env.Badge is not null)
{
    <div class="env-badge">@Env.Badge</div>
}
<header class="site-head">
    <a class="brand wordmark" href="/">
        <svg class="logo-mark" viewBox="0 0 64 64" aria-hidden="true">
            <path class="mark-path" d="M8 50 C 20 40, 12 26, 30 24 S 50 30, 56 12" />
            <circle cx="8" cy="50" r="4" fill="currentColor" />
            <circle cx="56" cy="12" r="4" fill="currentColor" />
            <circle cx="32" cy="24" r="3" fill="var(--color-accent-alt)" />
        </svg>
        HeritageTrail
    </a>
    <nav class="nav-stub" aria-label="Primary">
        <a class="@NavClass("/")" href="/">Home</a>
        <a class="@NavClass("/heritage-sites")" href="/heritage-sites">Heritage Sites</a>
        <a class="@NavClass("/explore")" href="/explore">Explore</a>
        <a class="@NavClass("/about")" href="/about/what-we-do">About us</a>
        <a class="@NavClass("/events")" href="/events">Events</a>
        <a class="@NavClass("/gallery")" href="/gallery">Gallery</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="nav-register" href="/account">ACCOUNT</a>
            @if (User.IsInRole("admin"))
            {
                <a class="nav-register" href="/admin">ADMIN</a>
            }
        }
        else
        {
            <a class="nav-register" href="/auth/register">REGISTER</a>
        }
    </nav>
    <div class="nav-actions">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" action="/auth/logout">
                @Html.AntiForgeryToken()
                <button class="linkbtn" type="submit">Log out</button>
            </form>
        }
        else
        {
            <a href="/auth/login">Log in</a>
        }
    </div>
</header>
<main class="page" id="main">
    @if (TempData["Notice"] is string notice)
    {
        <div class="notice">@notice</div>
    }
    @RenderBody()
</main>
<footer class="site-foot">
    <div class="foot-brand">
        <a class="brand wordmark" href="/">
            <svg class="logo-mark" viewBox="0 0 64 64" aria-hidden="true">
                <path class="mark-path" d="M8 50 C 20 40, 12 26, 30 24 S 50 30, 56 12" />
                <circle cx="8" cy="50" r="4" fill="currentColor" />
                <circle cx="56" cy="12" r="4" fill="currentColor" />
                <circle cx="32" cy="24" r="3" fill="var(--color-accent-alt)" />
            </svg>
            HeritageTrail
        </a>
        <p class="foot-mission">Walks, talks and exhibitions at heritage sites worldwide — the facts and the stories behind each place.</p>
    </div>
    <div class="foot-cols">
        <div>
            <p class="foot-head">Explore</p>
            <a href="/heritage-sites">Heritage Sites</a>
            <a href="/explore">Explore</a>
            <a href="/events">Events</a>
            <a href="/gallery">Gallery</a>
        </div>
        <div>
            <p class="foot-head">Organisation</p>
            <a href="/about/what-we-do">About us</a>
            <a href="/about/achievements">Achievements</a>
            <a href="/contact">Contact</a>
        </div>
        <div>
            <p class="foot-head">Members</p>
            <a href="/auth/register">Register</a>
            <a href="/auth/login">Log in</a>
            <a href="/account">My account</a>
        </div>
    </div>
    <div class="foot-base">
        <span>© 2026 HeritageTrail</span>
        <span>Photography and footage: Wikimedia Commons — attribution on each site page</span>
    </div>
</footer>
<script src="/js/motion.js"></script>
</body>
</html>

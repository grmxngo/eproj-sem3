@using HeritageTrail.Web.Models
@{
    var ev = (Event)ViewData["Event"]!;
    var site = ViewData["Site"] as HeritageSite;
    var interested = (bool)ViewData["Interested"]!;
    ViewData["Title"] = ev.Title;
}
<nav class="breadcrumb">
    <a href="/">Home</a> / <a href="/events">Events</a> / <span>@ev.Title</span>
</nav>

<section class="home-band" style="margin-top: var(--space-md)">
    <p class="eyebrow" style="color: var(--color-accent-alt)">@ev.Type</p>
    <h1 class="display" style="color: var(--color-bg); font-size: var(--fs-h1); margin: 0">@ev.Title</h1>
</section>

<div class="detail-cols">
    <article class="detail">
        <section>
            <h2><span class="sec-num">01</span>About this programme</h2>
            <p>@ev.Description</p>
        </section>

        @if (ev.StartDate < DateTime.UtcNow)
        {
            <p class="empty">This programme has already taken place.</p>
        }
        else if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" action="/events/@ev.Id/interest" style="margin-top: var(--space-md)">
                @Html.AntiForgeryToken()
                <button class="btn btn-primary" type="submit">@(interested ? "Remove interest" : "Interested")</button>
            </form>
        }
        else
        {
            <p><a href="/auth/login?returnUrl=/events/@ev.Slug">Log in</a> to register your interest.</p>
        }
    </article>

    <aside class="site-facts site-facts-dark">
        <p class="eyebrow">What to know</p>
        <ul class="auth-list">
            <li>Starts — @ev.StartDate.ToString("ddd dd MMM yyyy · HH:mm")</li>
            <li>Ends — @ev.EndDate.ToString("ddd dd MMM yyyy · HH:mm")</li>
            <li>Venue — @ev.Venue</li>
            @if (site is not null)
            {
                <li>Site — <a href="/heritage-sites/@site.Slug" style="color: var(--color-accent-alt)">@site.Name</a></li>
            }
        </ul>
    </aside>
</div>

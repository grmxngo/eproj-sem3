@using HeritageTrail.Web.Models
@{
    var about = (AboutPage)ViewData["Page"]!;
    var pages = (List<AboutPage>)ViewData["Pages"]!;
    ViewData["Title"] = about.Title;
}
<nav class="breadcrumb">
    <a href="/">Home</a> / <a href="/about/what-we-do">About us</a> / <span>@about.Title</span>
</nav>

<section class="page-head">
    <p class="eyebrow">About us</p>
    <h1>@about.Title</h1>
</section>

<div class="detail-cols">
    <article class="detail">
        <p>@about.Content</p>
    </article>
    <aside class="site-facts">
        <p class="eyebrow">About pages</p>
        <ul class="auth-list">
            @foreach (var p in pages)
            {
                <li><a href="/about/@p.Slug" style="color: var(--color-accent)">@p.Title</a></li>
            }
        </ul>
    </aside>
</div>

@using HeritageTrail.Web.Models
@{
    var items = (List<GalleryItem>)ViewData["Items"]!;
    ViewData["Title"] = "Gallery";
}
<h1 class="page-title">Gallery</h1>
<div class="gallery-grid">
    @foreach (var item in items)
    {
        <figure class="tile">
            <div class="art" aria-hidden="true"></div>
            <figcaption>@item.Caption @(item.Credit is null ? "" : $"· {item.Credit}")</figcaption>
        </figure>
    }
</div>
@if (items.Count == 0)
{
    <p class="empty">No images yet.</p>
}

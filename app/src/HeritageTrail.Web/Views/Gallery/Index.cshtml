@using HeritageTrail.Web.Models
@{
    var items = (List<GalleryItem>)ViewData["Items"]!;
    var imgs = new[] { "/images/preview/card1.jpg", "/images/preview/card2.jpg", "/images/preview/card3.jpg", "/images/preview/hero.jpg" };
    ViewData["Title"] = "Gallery";
}
<section class="page-head">
    <p class="eyebrow">Programmes</p>
    <h1>Gallery</h1>
    <p class="lede">Images of heritage sites and programmes we have run.</p>
</section>
<div class="gallery-grid gallery-lead">
    @{ var i = 0; }
    @foreach (var item in items)
    {
        var src = string.IsNullOrWhiteSpace(item.ImageUrl) ? imgs[i % imgs.Length] : item.ImageUrl;
        <figure class="tile">
            <img class="art" src="@src" alt="@item.Caption" />
            <figcaption>@item.Caption @(string.IsNullOrWhiteSpace(item.Credit) ? "" : $"· {item.Credit}")</figcaption>
        </figure>
        i++;
    }
</div>
@if (items.Count == 0)
{
    <p class="empty">No images yet.</p>
}

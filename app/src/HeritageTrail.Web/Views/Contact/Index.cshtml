@using HeritageTrail.Web.Models
@{
    var info = ViewData["Info"] as ContactInfo;
    ViewData["Title"] = "Contact";
}
<section class="page-head">
    <p class="eyebrow">Contact</p>
    <h1>Contact us</h1>
    <p class="lede">Ask the organisation — we answer every query.</p>
</section>

<div class="auth-cols">
    <form method="post" action="/contact" class="stack form-mono form-f1">
        @Html.AntiForgeryToken()
        <label>Name <input name="name" required /></label>
        <label>Email <input type="email" name="email" required /></label>
        <label>Message <textarea name="message" rows="4" required></textarea></label>
        <div class="action-row">
            <button class="btn btn-primary" type="submit">Send</button>
        </div>
    </form>
    <aside class="auth-margin">
        <p class="eyebrow">Office</p>
        <ul class="auth-list">
            <li>@info?.Address</li>
            <li>@info?.Phone</li>
            <li>@info?.Email</li>
        </ul>
        <p class="mono-note">@info?.Note</p>
    </aside>
</div>

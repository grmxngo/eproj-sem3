@using HeritageTrail.Web.Models
@{
    var info = ViewData["Info"] as ContactInfo;
    ViewData["Title"] = "Contact";
}
<h1 class="page-title">Contact us</h1>

@if (info is not null)
{
    <p class="detail-meta">@info.Address · @info.Phone · @info.Email</p>
    <p class="empty">@info.Note</p>
}

<h2 class="section-title">Send a message</h2>
<form method="post" action="/contact" class="stack" style="max-width: 34rem">
    @Html.AntiForgeryToken()
    <label>Name <input name="name" required /></label>
    <label>Email <input type="email" name="email" required /></label>
    <label>Message <textarea name="message" rows="4" required></textarea></label>
    <button class="btn btn-primary" type="submit">Send</button>
</form>

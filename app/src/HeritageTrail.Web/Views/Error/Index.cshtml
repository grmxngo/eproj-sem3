@{
    var code = (int)ViewData["Code"]!;
    var message = ViewData["Message"] as string ?? "Something went wrong.";
}
<section class="page-head">
    <p class="eyebrow">Error @code</p>
    <h1>@(code == 404 ? "Page not found" : code == 403 ? "Access denied" : "Something went wrong")</h1>
    <p class="lede">@message</p>
</section>
<div class="action-row">
    <a class="btn btn-primary" href="/">Back to home</a>
    <a class="btn btn-ghost" href="/heritage-sites">Explore sites</a>
</div>

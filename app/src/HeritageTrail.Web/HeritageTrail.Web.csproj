<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>HeritageTrail.Web</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="3.13.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Content\design\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Content\config\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
